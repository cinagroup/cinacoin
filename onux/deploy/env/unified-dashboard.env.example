# =============================================================================
# Cinacoin Unified Dashboard - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in actual values.
# NEVER commit .env.production to version control.
# =============================================================================

# --- Application ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info

# --- Public URLs (exposed to browser) ---
NEXT_PUBLIC_APP_URL=https://app.cinacoin.com
NEXT_PUBLIC_API_URL=https://api.cinacoin.com
NEXT_PUBLIC_WS_URL=wss://ws.cinacoin.com
NEXT_PUBLIC_ENVIRONMENT=production

# --- Backend Services (server-side only) ---
AUTH_SERVICE_URL=http://auth-service:3200
USER_SERVICE_URL=http://user-service:3201
API_GATEWAY_URL=http://api-gateway:8787
SERVICE_API_KEY=<SHARED_SECRET_BETWEEN_SERVICES>

# --- Authentication (SSR) ---
AUTH_COOKIE_DOMAIN=.cinacoin.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_TTL=86400             # 24 hours

# --- WalletConnect ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<FROM_CLOUD_WALLETCONNECT_COM>

# --- Blockchain Config ---
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1
NEXT_PUBLIC_SUPPORTED_CHAINS=1,42161,137,8453
NEXT_PUBLIC_EXPLORER_URL=https://explorer.cinacoin.com

# --- Fiat On-Ramp ---
NEXT_PUBLIC_MOONPAY_API_KEY=<FROM_MOONPAY>
NEXT_PUBLIC_MOONPAY_ENV=production

# --- Analytics ---
NEXT_PUBLIC_ANALYTICS_ID=<FROM_ANALYTICS_PROVIDER>
NEXT_PUBLIC_SENTRY_DSN=<FROM_SENTRY>
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_SWAP=true
NEXT_PUBLIC_ENABLE_BRIDGE=true
NEXT_PUBLIC_ENABLE_STAKING=true
NEXT_PUBLIC_ENABLE_NFT=true
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_PASSKEYS=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# --- CDN / Static Assets ---
NEXT_PUBLIC_CDN_URL=https://cdn.cinacoin.com
ASSET_PREFIX=https://cdn.cinacoin.com

# --- Image Optimization ---
NEXT_IMAGE_DOMAINS=cdn.cinacoin.com,avatars.githubusercontent.com,lh3.googleusercontent.com
