# =============================================================================
# Cinacoin Auth Service - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in actual values.
# NEVER commit .env.production to version control.
# =============================================================================

# --- Application ---
NODE_ENV=production
PORT=3200
HOSTNAME=0.0.0.0
LOG_LEVEL=info                    # debug | info | warn | error
LOG_FORMAT=json                   # json | pretty

# --- Database ---
DATABASE_URL=postgresql://cinacoin_auth:<PASSWORD>@postgres:5432/cinacoin_auth
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Redis (session cache / rate limiting) ---
REDIS_URL=redis://:<PASSWORD>@redis-master:6379/0
REDIS_PREFIX=cinacoin:auth:

# --- JWT ---
JWT_SECRET=<GENERATE_64_HEX_CHARS>
JWT_ACCESS_TOKEN_TTL=900          # 15 minutes in seconds
JWT_REFRESH_TOKEN_TTL=604800      # 7 days in seconds
JWT_ISSUER=cinacoin-auth
JWT_AUDIENCE=cinacoin-platform

# --- Session ---
SESSION_SECRET=<GENERATE_64_HEX_CHARS>
SESSION_MAX_PER_USER=5            # max concurrent sessions

# --- Encryption (for sensitive data at rest) ---
ENCRYPTION_KEY=<GENERATE_64_HEX_CHARS>

# --- CORS ---
CORS_ORIGINS=https://cinacoin.com,https://app.cinacoin.com,https://dashboard.cinacoin.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=10           # stricter for login endpoints

# --- Web3 / SIWE ---
SIWE_DOMAIN=cinacoin.com
SIWE_STATEMENT=Sign in to Cinacoin
SIWE_CHAIN_ID=1
SIWE_NONCE_TTL_SECONDS=300

# --- OAuth Providers ---
# Google
GOOGLE_CLIENT_ID=<FROM_GOOGLE_CLOUD_CONSOLE>
GOOGLE_CLIENT_SECRET=<FROM_GOOGLE_CLOUD_CONSOLE>
GOOGLE_REDIRECT_URI=https://api.cinacoin.com/auth/callback/google

# GitHub
GITHUB_CLIENT_ID=<FROM_GITHUB_DEV_SETTINGS>
GITHUB_CLIENT_SECRET=<FROM_GITHUB_DEV_SETTINGS>
GITHUB_REDIRECT_URI=https://api.cinacoin.com/auth/callback/github

# Discord
DISCORD_CLIENT_ID=<FROM_DISCORD_DEV_PORTAL>
DISCORD_CLIENT_SECRET=<FROM_DISCORD_DEV_PORTAL>
DISCORD_REDIRECT_URI=https://api.cinacoin.com/auth/callback/discord

# --- WebAuthn / Passkeys ---
WEBAUTHN_RP_NAME=Cinacoin
WEBAUTHN_RP_ID=cinacoin.com
WEBAUTHN_ORIGIN=https://cinacoin.com
WEBAUTHN_TIMEOUT_MS=60000

# --- TOTP MFA ---
TOTP_ISSUER=Cinacoin
TOTP_WINDOW=1                     # allow ±1 time step
TOTP_DIGITS=6
TOTP_PERIOD=30

# --- Email (verification / OTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false                 # true for 465, false for 587
SMTP_USER=apikey
SMTP_PASSWORD=<FROM_RESEND_OR_PROVIDER>
SMTP_FROM=noreply@cinacoin.com
SMTP_FROM_NAME=Cinacoin

# --- Inter-Service Communication ---
USER_SERVICE_URL=http://user-service:3201
API_GATEWAY_URL=http://api-gateway:8787
SERVICE_API_KEY=<SHARED_SECRET_BETWEEN_SERVICES>

# --- Monitoring ---
METRICS_ENABLED=true
METRICS_PORT=9090
SENTRY_DSN=<FROM_SENTRY>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Feature Flags ---
ENABLE_PASSKEYS=true
ENABLE_TOTP=true
ENABLE_OAUTH=true
ENABLE_WEB3_AUTH=true
ENABLE_EMAIL_VERIFICATION=true
MAINTENANCE_MODE=false
