# =============================================================================
# Cinacoin API Gateway - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in actual values.
# NEVER commit .env.production to version control.
# =============================================================================

# --- Application ---
NODE_ENV=production
PORT=8787
HOSTNAME=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=json

# --- Database (Cloudflare D1 for edge, or PostgreSQL for dedicated) ---
# Option A: Cloudflare D1 (edge deployment)
D1_DATABASE_ID=<FROM_CLOUDFLARE>
CLOUDFLARE_API_TOKEN=<FROM_CLOUDFLARE>
CLOUDFLARE_ACCOUNT_ID=<FROM_CLOUDFLARE>

# Option B: PostgreSQL (dedicated deployment)
DATABASE_URL=postgresql://cinacoin_gateway:<PASSWORD>@postgres:5432/cinacoin_gateway

# --- Redis (rate limiting, caching) ---
REDIS_URL=redis://:<PASSWORD>@redis-master:6379/2
REDIS_PREFIX=cinacoin:gateway:

# --- Authentication ---
AUTH_SERVICE_URL=http://auth-service:3200
USER_SERVICE_URL=http://user-service:3201
SERVICE_API_KEY=<SHARED_SECRET_BETWEEN_SERVICES>
JWT_PUBLIC_KEY=<PUBLIC_KEY_PEM_FOR_VERIFYING_JWT>

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT_RPS=100
RATE_LIMIT_BURST=200
RATE_LIMIT_AUTH_RPS=20
RATE_LIMIT_RPC_RPS=50
RATE_LIMIT_STORAGE=redis           # redis | memory

# --- API Key Management ---
API_KEY_HASH_ALGO=sha256
API_KEY_PREFIX=ck_                # prefix for generated API keys
API_KEY_MAX_PER_PROJECT=10

# --- RPC Proxy ---
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<KEY>
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<KEY>
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<KEY>
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<KEY>
RPC_TIMEOUT_MS=30000
RPC_MAX_RETRIES=3

# --- Bundler (ERC-4337) ---
BUNDLER_URL=https://api.cinacoin.com/bundler
BUNDLER_API_KEY=<BUNDLER_API_KEY>
BUNDLER_PRIVATE_KEY=<BUNDLER_EXECUTOR_PRIVATE_KEY>
BUNDLER_SKIP_AUTH=false
BUNDLER_API_KEYS=<COMMA_SEPARATED_ALLOWED_KEYS>
BUNDLER_MAX_OPS_PER_BATCH=10
BUNDLER_GAS_PRICE_BUFFER_PERCENT=20

# --- Paymaster ---
PAYMASTER_URL=https://api.cinacoin.com/paymaster
PAYMASTER_API_KEY=<PAYMASTER_API_KEY>
PAYMASTER_PRIVATE_KEY=<PAYMASTER_SIGNING_KEY>
PAYMASTER_MAX_SPEND_USD=100
PAYMASTER_RATE_LIMIT_PER_KEY=1000

# --- CORS ---
CORS_ORIGINS=*                     # API gateway typically allows all origins
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_MAX_AGE=86400

# --- Webhook ---
WEBHOOK_SECRET=<FOR_SIGNING_WEBHOOK_PAYLOADS>
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRY_MAX=3

# --- Inter-Service ---
ANALYTICS_SERVICE_URL=http://analytics-service:3202

# --- Monitoring ---
METRICS_ENABLED=true
METRICS_PORT=9092
SENTRY_DSN=<FROM_SENTRY>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Feature Flags ---
ENABLE_RPC_PROXY=true
ENABLE_BUNDLER=true
ENABLE_PAYMASTER=true
ENABLE_API_KEYS=true
ENABLE_ANALYTICS=true
MAINTENANCE_MODE=false
