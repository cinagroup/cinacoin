# =============================================================================
# Cinacoin API Gateway - Production Dockerfile
# Multi-stage build for minimal image size
# =============================================================================

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml* ./
COPY apps/api-gateway/package.json ./apps/api-gateway/

RUN pnpm install --frozen-lockfile --prod=false

# --- Stage 2: Build ---
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api-gateway/node_modules ./apps/api-gateway/node_modules

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.json ./
COPY apps/api-gateway ./apps/api-gateway
COPY packages/ packages/

RUN pnpm --filter api-gateway build

# --- Stage 3: Production Runtime ---
FROM node:22-alpine AS runner
LABEL maintainer="Cinacoin Team <dev@cinacoin.com>"

# Security: run as non-root
RUN addgroup --system --gid 1001 cinacoin \
    && adduser --system --uid 1001 gateway

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8787
ENV HOSTNAME=0.0.0.0

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy built assets
COPY --from=builder --chown=gateway:cinacoin /app/apps/api-gateway/dist ./apps/api-gateway/dist
COPY --from=builder --chown=gateway:cinacoin /app/apps/api-gateway/package.json ./apps/api-gateway/
COPY --from=builder --chown=gateway:cinacoin /app/apps/api-gateway/node_modules ./apps/api-gateway/node_modules
COPY --from=builder --chown=gateway:cinacoin /app/apps/api-gateway/migrations ./apps/api-gateway/migrations

# Copy workspace node_modules for shared deps
COPY --from=builder --chown=gateway:cinacoin /app/node_modules ./node_modules

USER gateway

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8787/health || exit 1

CMD ["node", "apps/api-gateway/dist/index.js"]
