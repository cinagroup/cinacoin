# =============================================================================
# Cinacoin Auth Service - Production Dockerfile
# Multi-stage build for minimal image size
# =============================================================================

# --- Stage 1: Dependencies ---
FROM node:22-alpine AS deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml* ./
COPY apps/auth-service/package.json ./apps/auth-service/

RUN pnpm install --frozen-lockfile --prod=false

# --- Stage 2: Build ---
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/auth-service/node_modules ./apps/auth-service/node_modules

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.json ./
COPY apps/auth-service ./apps/auth-service
COPY packages/ packages/

RUN pnpm --filter auth-service build

# --- Stage 3: Production Runtime ---
FROM node:22-alpine AS runner
LABEL maintainer="Cinacoin Team <dev@cinacoin.com>"

# Security: run as non-root
RUN addgroup --system --gid 1001 cinacoin \
    && adduser --system --uid 1001 authsvc

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3200
ENV HOSTNAME=0.0.0.0

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy built assets
COPY --from=builder --chown=authsvc:cinacoin /app/apps/auth-service/.next/standalone ./
COPY --from=builder --chown=authsvc:cinacoin /app/apps/auth-service/.next/static ./apps/auth-service/.next/static
COPY --from=builder --chown=authsvc:cinacoin /app/apps/auth-service/public ./apps/auth-service/public
COPY --from=builder --chown=authsvc:cinacoin /app/apps/auth-service/migrations ./apps/auth-service/migrations

USER authsvc

EXPOSE 3200

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3200/api/health || exit 1

CMD ["node", "apps/auth-service/server.js"]
