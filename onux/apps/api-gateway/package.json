{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cinacoin API Gateway — Cloudflare Workers reverse proxy with JWT auth, rate limiting, and request routing",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "wrangler d1 migrations apply cinacoin-api-gateway --local",
    "db:migrate:prod": "wrangler d1 migrations apply cinacoin-api-gateway --remote",
    "logs": "wrangler tail",
    "logs:prod": "wrangler tail --env production"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "hono-rate-limiter": "^0.4.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250000.0",
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "typescript": "^5.7.0",
    "vitest": "2",
    "wrangler": "^3.90.0"
  }
}
