{
  "name": "user-service",
  "version": "0.1.0",
  "private": true,
  "description": "Cinacoin User Service - Microservice for user and team management",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3201",
    "build": "next build",
    "start": "next start -p 3201",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node --loader ts-node/esm src/db/migrate.ts",
    "db:migrate:prod": "NODE_ENV=production node --loader ts-node/esm src/db/migrate.ts"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "ts-node": "^10.9.0"
  }
}
