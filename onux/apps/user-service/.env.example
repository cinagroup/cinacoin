# User Service Configuration
DATABASE_URL=postgresql://cinacoin:cinacoin@localhost:5432/cinacoin_users
PORT=3201
NODE_ENV=development

# Service Discovery
AUTH_SERVICE_URL=http://localhost:3200
API_GATEWAY_URL=http://localhost:8787

# Inter-service auth
SERVICE_API_KEY=change-me-in-production

# Cloudflare Queue (for event-driven communication)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_NAME=user-events

# Logging
LOG_LEVEL=info
