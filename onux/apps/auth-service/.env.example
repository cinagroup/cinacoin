# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinacoin_auth
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3200
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# OAuth 2.0 Social Login Providers (Phase 2)
# ============================================================================

# OAuth redirect base URL (callback URLs will be appended)
OAUTH_REDIRECT_BASE_URL=http://localhost:3200/api/auth/oauth

# OAuth state expiry in minutes (default: 10)
OAUTH_STATE_EXPIRY_MINUTES=10

# Google OAuth 2.0 / OIDC
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth
# Get credentials from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ============================================================================
# OAuth Callback URLs (register these in your provider dashboards)
# ============================================================================
# Google:  http://localhost:3200/api/auth/oauth/google/callback
# GitHub:  http://localhost:3200/api/auth/oauth/github/callback
# Discord: http://localhost:3200/api/auth/oauth/discord/callback
