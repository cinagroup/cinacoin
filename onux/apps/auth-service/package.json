{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "Cinacoin Unified Authentication Service - JWT-based auth with PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node --loader ts-node/esm src/db/migrate.ts",
    "db:migrate:prod": "NODE_ENV=production node --loader ts-node/esm src/db/migrate.ts"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "@simplewebauthn/browser": "^10.0.0",
    "@simplewebauthn/server": "^10.0.0",
    "@wagmi/core": "^2.14.0",
    "arctic": "^3.0.0",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.0.0",
    "otpauth": "^9.3.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.1",
    "viem": "^2.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
