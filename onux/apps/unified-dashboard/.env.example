# Unified Dashboard Environment Variables

# WebSocket endpoint for real-time data
NEXT_PUBLIC_WS_URL=wss://api.cinacoin.com/ws

# API base URL
NEXT_PUBLIC_API_URL=https://api.cinacoin.com

# Auth provider
NEXT_PUBLIC_AUTH_URL=https://api.cinacoin.com/auth

# Feature flags
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_APP_SWITCHER=true
