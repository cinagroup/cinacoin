{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "#imports": ["./src/runtime/imports.d.ts"],
      "#app": ["./node_modules/nuxt/dist/app"],
      "#build/types": ["./src/runtime/nuxt-types.d.ts"]
    },
    "types": ["nuxt", "@nuxt/kit", "h3"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "playground"]
}
