# On-chain integration test environment variables
# Copy this file to .env and fill in your values.

# Sepolia testnet RPC URL (Ethereum)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Polygon Amoy testnet RPC URL
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Test wallet private key (required for sign/transaction tests)
# NEVER use a mainnet wallet with funds!
TEST_PRIVATE_KEY=0x...

# Test wallet address derived from TEST_PRIVATE_KEY
TEST_ADDRESS=0x...

# Optional: fallback RPC URLs
SEPOLIA_RPC_FALLBACK=https://sepolia.drpc.org
AMOY_RPC_FALLBACK=https://rpc.ankr.com/polygon_amoy

# Connection timeout in milliseconds (default: 5000)
RPC_TIMEOUT_MS=5000
