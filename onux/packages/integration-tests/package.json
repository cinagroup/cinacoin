{
  "name": "@cinacoin/integration-tests",
  "private": true,
  "version": "0.1.0",
  "description": "On-chain integration tests against real testnets (Sepolia, Amoy, etc.)",
  "type": "module",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:connect": "vitest run --reporter=verbose tests/onchain-connect.test.ts",
    "test:sign": "vitest run --reporter=verbose tests/onchain-sign.test.ts",
    "test:transaction": "vitest run --reporter=verbose tests/onchain-transaction.test.ts",
    "test:multichain": "vitest run --reporter=verbose tests/onchain-multichain.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "viem": "^2.30.0"
  }
}
