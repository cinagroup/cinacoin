{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@cinacoin/core-sdk": ["../../packages/core-sdk/dist/index.js"],
      "@cinacoin/react": ["../../packages/react/dist/index.js"],
      "@cinacoin/vue": ["../../packages/vue/dist/index.js"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
