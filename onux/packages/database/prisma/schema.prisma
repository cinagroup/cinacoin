// ============================================================================
// Cinacoin Unified Database Schema
// Version: 1.0.0
// Date: 2026-06-08
// ORM: Prisma (PostgreSQL 16+)
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  pending   // Registered but email not verified
  active    // Active user
  suspended // Temporarily suspended
  disabled  // Permanently disabled
  deleted   // Soft-deleted (30-day grace period)
}

enum AuthMethod {
  password   // Email + password
  oauth      // OAuth social login
  web3       // SIWE (Sign-In with Ethereum)
  passkey    // WebAuthn/FIDO2
  magic_link // Passwordless email link
  api_key    // API key authentication
}

enum MfaType {
  totp          // Time-based OTP (Google Authenticator)
  webauthn      // FIDO2/WebAuthn
  email_otp     // Email-based OTP
  sms_otp       // SMS-based OTP
  recovery_code // One-time recovery code
}

enum OAuthProvider {
  google
  github
  discord
  apple
  microsoft
  custom
}

enum TokenType {
  access
  refresh
  id
  authorization_code
  password_reset
  email_verification
  magic_link
  api_key
}

enum GlobalRole {
  super_admin
  admin
  user
  guest
}

enum OrgMemberRole {
  owner
  admin
  member
  viewer
}

enum AuditAction {
  user_register
  user_login
  user_login_failed
  user_logout
  user_password_change
  user_password_reset_request
  user_password_reset_complete
  user_email_change
  user_email_verified
  user_profile_update
  user_account_delete_request
  user_account_delete_complete
  user_account_restore
  mfa_enable
  mfa_disable
  mfa_challenge
  mfa_verify_success
  mfa_verify_failed
  mfa_recovery_used
  oauth_consent_grant
  oauth_consent_revoke
  oauth_token_issued
  oauth_token_revoked
  session_create
  session_destroy
  session_destroy_all
  api_key_create
  api_key_revoke
  org_create
  org_update
  org_delete
  org_member_add
  org_member_remove
  org_member_role_change
  team_create
  team_update
  team_delete
  team_member_add
  team_member_remove
  permission_grant
  permission_revoke
  admin_user_suspend
  admin_user_unsuspend
  admin_user_impersonate
  system_config_change
}

// ============================================================================
// CORE TABLES
// ============================================================================

model User {
  id              String   @id @default(uuid()) @db.Uuid
  externalId      String   @unique @default(dbgenerated("'usr_' || encode(gen_random_bytes(16), 'hex')")) @map("external_id") @db.VarChar(32)
  
  // Authentication
  email           String   @unique @db.Citext
  emailVerified   Boolean  @default(false) @map("email_verified")
  passwordHash    String?  @map("password_hash")
  passwordSalt    String?  @map("password_salt")
  
  // Profile
  displayName     String?  @map("display_name") @db.VarChar(100)
  firstName       String?  @map("first_name") @db.VarChar(50)
  lastName        String?  @map("last_name") @db.VarChar(50)
  avatarUrl       String?  @map("avatar_url") @db.Text
  locale          String   @default("en") @db.VarChar(10)
  timezone        String   @default("UTC") @db.VarChar(50)
  
  // Status
  status          UserStatus @default(pending)
  globalRole      GlobalRole @default(user) @map("global_role")
  
  // MFA
  mfaEnabled      Boolean  @default(false) @map("mfa_enabled")
  mfaRequired     Boolean  @default(false) @map("mfa_required")
  mfaMethods      MfaType[] @default([]) @map("mfa_methods")
  
  // Web3
  defaultChain    String?  @map("default_chain") @db.VarChar(20)
  
  // Security
  failedLoginAttempts Int  @default(0) @map("failed_login_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp     String?  @map("last_login_ip") @db.Inet
  lastLoginUserAgent String? @map("last_login_user_agent") @db.Text
  lastPasswordChange DateTime? @map("last_password_change") @db.Timestamptz
  
  // Deletion
  deleteRequestedAt DateTime? @map("delete_requested_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  
  // Metadata
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  // Relations
  passwordHistory   PasswordHistory[]
  oauthAccounts     OAuthAccount[]
  web3Wallets       Web3Wallet[]
  passkeys          Passkey[]
  mfaMethodsList    MfaMethod[]
  sessions          Session[]
  verificationTokens VerificationToken[]
  ownedOrgs         Organization[]     @relation("OrgOwner")
  orgMemberships    OrgMember[]
  teamMemberships   TeamMember[]
  userRoles         UserRole[]
  userPermissions   UserPermission[]
  apiKeys           ApiKey[]
  invitationsSent   Invitation[]       @relation("InvitationSender")
  notificationPrefs NotificationPreference?
  auditLogs         AuditLog[]         @relation("AuditActor")
  
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([globalRole])
  @@map("users")
}

model PasswordHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  passwordHash  String   @map("password_hash")
  passwordSalt  String   @map("password_salt")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, createdAt])
  @@index([userId])
  @@map("password_history")
}

model OAuthAccount {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        OAuthProvider
  providerUserId  String       @map("provider_user_id") @db.VarChar(255)
  providerEmail   String?      @map("provider_email") @db.Citext
  accessToken     String?      @map("access_token") @db.Text
  refreshToken    String?      @map("refresh_token") @db.Text
  tokenExpiresAt  DateTime?    @map("token_expires_at") @db.Timestamptz
  scope           String?
  rawProfile      Json         @default("{}") @map("raw_profile")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Web3Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  address     String   @db.VarChar(42)
  chain       String   @default("ethereum") @db.VarChar(20)
  chainId     Int?     @map("chain_id")
  isPrimary   Boolean  @default(false) @map("is_primary")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  nonce       String   @default(dbgenerated("encode(gen_random_bytes(32), 'hex')")) @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([address, chain])
  @@index([userId])
  @@map("web3_wallets")
}

model Passkey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  credentialId   Bytes    @unique @map("credential_id") @db.Bytea
  publicKey      Bytes    @map("public_key") @db.Bytea
  counter        BigInt   @default(0)
  deviceType     String?  @map("device_type") @db.VarChar(50)
  backupEligible Boolean  @default(false) @map("backup_eligible")
  backedUp       Boolean  @default(false) @map("backed_up")
  transports     String[] @default([])
  name           String?  @db.VarChar(100)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("passkeys")
}

model MfaMethod {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              MfaType
  isEnabled         Boolean  @default(true) @map("is_enabled")
  isPrimary         Boolean  @default(false) @map("is_primary")
  totpSecret        String?  @map("totp_secret")
  totpVerified      Boolean? @map("totp_verified")
  contactInfo       String?  @map("contact_info") @db.VarChar(255)
  recoveryCodesHash String[] @map("recovery_codes_hash")
  name              String?  @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("mfa_methods")
}

// ============================================================================
// SESSION & TOKEN MANAGEMENT
// ============================================================================

model Session {
  id                     String     @id @default(uuid()) @db.Uuid
  userId                 String     @map("user_id") @db.Uuid
  tokenJti               String     @unique @map("token_jti") @db.VarChar(128)
  refreshTokenHash       String     @unique @map("refresh_token_hash") @db.VarChar(128)
  authMethod             AuthMethod @map("auth_method")
  
  // Device info
  ipAddress              String     @map("ip_address") @db.Inet
  userAgent              String?    @map("user_agent") @db.Text
  deviceName             String?    @map("device_name") @db.VarChar(100)
  deviceType             String?    @map("device_type") @db.VarChar(20)
  osName                 String?    @map("os_name") @db.VarChar(50)
  browserName            String?    @map("browser_name") @db.VarChar(50)
  countryCode            String?    @map("country_code") @db.VarChar(2)
  
  // Token lifecycle
  accessTokenExpiresAt   DateTime   @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt  DateTime   @map("refresh_token_expires_at") @db.Timestamptz
  
  // Activity
  lastActiveAt           DateTime   @default(now()) @map("last_active_at") @db.Timestamptz
  lastActiveIp           String?    @map("last_active_ip") @db.Inet
  
  // Status
  isRevoked              Boolean    @default(false) @map("is_revoked")
  revokedAt              DateTime?  @map("revoked_at") @db.Timestamptz
  revokeReason           String?    @map("revoke_reason") @db.VarChar(100)
  
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz
  
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([tokenJti])
  @@index([refreshTokenHash])
  @@index([refreshTokenExpiresAt])
  @@index([userId, lastActiveAt(sort: Desc)])
  @@map("sessions")
}

model TokenBlacklist {
  id          String    @id @default(uuid()) @db.Uuid
  jti         String    @unique @db.VarChar(128)
  tokenType   TokenType @map("token_type")
  userId      String?   @map("user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime  @default(now()) @map("revoked_at") @db.Timestamptz
  revokedBy   String?   @map("revoked_by") @db.Uuid
  reason      String?   @db.VarChar(200)
  
  @@index([jti])
  @@index([expiresAt])
  @@map("token_blacklist")
}

model VerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       TokenType
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  metadata   Json      @default("{}")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  usedIp     String?   @map("used_ip") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([tokenHash])
  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ============================================================================
// OAUTH 2.0 / OIDC PROVIDER TABLES
// ============================================================================

model OAuthClient {
  id                      String   @id @default(uuid()) @db.Uuid
  clientId                String   @unique @default(dbgenerated("encode(gen_random_bytes(32), 'hex')")) @map("client_id") @db.VarChar(64)
  clientSecretHash        String?  @map("client_secret_hash") @db.VarChar(128)
  
  name                    String   @db.VarChar(100)
  description             String?
  iconUrl                 String?  @map("icon_url") @db.Text
  websiteUrl              String?  @map("website_url") @db.Text
  
  ownerId                 String?  @map("owner_id") @db.Uuid
  isFirstParty            Boolean  @default(false) @map("is_first_party")
  isConfidential          Boolean  @default(true) @map("is_confidential")
  
  redirectUris            String[] @default([]) @map("redirect_uris")
  allowedScopes           String[] @default(["openid", "profile", "email"]) @map("allowed_scopes")
  defaultScopes           String[] @default(["openid", "profile", "email"]) @map("default_scopes")
  grantTypes              String[] @default(["authorization_code", "refresh_token"]) @map("grant_types")
  responseTypes           String[] @default(["code"]) @map("response_types")
  tokenEndpointAuthMethod String?  @default("client_secret_post") @map("token_endpoint_auth_method") @db.VarChar(50)
  
  accessTokenTtl          Int      @default(900) @map("access_token_ttl")
  refreshTokenTtl         Int      @default(2592000) @map("refresh_token_ttl")
  idTokenTtl              Int      @default(900) @map("id_token_ttl")
  authCodeTtl             Int      @default(600) @map("auth_code_ttl")
  
  pkceRequired            Boolean  @default(true) @map("pkce_required")
  isActive                Boolean  @default(true) @map("is_active")
  
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  consents                OAuthConsent[]
  
  @@index([clientId])
  @@index([ownerId])
  @@map("oauth_clients")
}

model OAuthConsent {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  grantedScopes String[]  @map("granted_scopes")
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("oauth_consents")
}

// ============================================================================
// ORGANIZATIONS & TEAMS
// ============================================================================

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  externalId    String   @unique @default(dbgenerated("'org_' || encode(gen_random_bytes(16), 'hex')")) @map("external_id") @db.VarChar(32)
  
  name          String   @db.VarChar(100)
  slug          String   @unique @db.VarChar(50)
  description   String?
  avatarUrl     String?  @map("avatar_url") @db.Text
  
  ownerId       String   @map("owner_id") @db.Uuid
  isPersonal    Boolean  @default(false) @map("is_personal")
  
  mfaRequired   Boolean  @default(false) @map("mfa_required")
  ssoEnabled    Boolean  @default(false) @map("sso_enabled")
  ssoConfig     Json     @default("{}") @map("sso_config")
  ipAllowlist   String[] @default([]) @map("ip_allowlist")
  
  plan          String   @default("free") @db.VarChar(20)
  maxMembers    Int      @default(5) @map("max_members")
  
  isActive      Boolean  @default(true) @map("is_active")
  
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  owner         User     @relation("OrgOwner", fields: [ownerId], references: [id])
  members       OrgMember[]
  teams         Team[]
  roles         Role[]
  projects      Project[]
  
  @@index([ownerId])
  @@index([slug])
  @@map("organizations")
}

model OrgMember {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  role      OrgMemberRole @default(member)
  
  invitedBy String?       @map("invited_by") @db.Uuid
  invitedAt DateTime?     @map("invited_at") @db.Timestamptz
  joinedAt  DateTime      @default(now()) @map("joined_at") @db.Timestamptz
  
  isActive  Boolean       @default(true) @map("is_active")
  
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("org_members")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(50)
  description String?
  createdBy   String?  @map("created_by") @db.Uuid
  
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  
  @@unique([orgId, slug])
  @@index([orgId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// ============================================================================
// RBAC - PERMISSIONS
// ============================================================================

model Permission {
  id            String   @id @default(uuid()) @db.Uuid
  resource      String   @db.VarChar(50)
  action        String   @db.VarChar(50)
  qualifier     String?  @db.VarChar(50)
  description   String?
  permissionKey String   @unique @map("permission_key") @db.VarChar(150)
  
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  
  @@unique([resource, action, qualifier])
  @@map("permissions")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(50)
  slug         String   @db.VarChar(50)
  description  String?
  scope        String   @default("global") @db.VarChar(20)
  appId        String?  @map("app_id") @db.VarChar(50)
  orgId        String?  @map("org_id") @db.Uuid
  inheritsFrom String?  @map("inherits_from") @db.Uuid
  isSystem     Boolean  @default(false) @map("is_system")
  
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  parent       Role?    @relation("RoleInheritance", fields: [inheritsFrom], references: [id], onDelete: SetNull)
  children     Role[]   @relation("RoleInheritance")
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]
  
  @@unique([slug, scope, appId, orgId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  isDeny       Boolean  @default(false) @map("is_deny")
  
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  orgId      String?   @map("org_id") @db.Uuid
  teamId     String?   @map("team_id") @db.Uuid
  
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  isActive   Boolean   @default(true) @map("is_active")
  
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([roleId])
  @@index([orgId])
  @@index([expiresAt])
  @@map("user_roles")
}

model UserPermission {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  isDeny       Boolean   @default(false) @map("is_deny")
  orgId        String?   @map("org_id") @db.Uuid
  resourceId   String?   @map("resource_id") @db.VarChar(100)
  
  grantedBy    String?   @map("granted_by") @db.Uuid
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([userId, permissionId, orgId, resourceId])
  @@index([userId])
  @@map("user_permissions")
}

// ============================================================================
// API KEYS
// ============================================================================

model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  keyPrefix     String    @map("key_prefix") @db.VarChar(16)
  keyHash       String    @unique @map("key_hash") @db.VarChar(128)
  
  userId        String    @map("user_id") @db.Uuid
  orgId         String?   @map("org_id") @db.Uuid
  
  name          String    @db.VarChar(100)
  description   String?
  scopes        String[]  @default([])
  permissions   String[]  @default([])
  
  ipAllowlist   String[]  @default([]) @map("ip_allowlist")
  rateLimit     Int?      @map("rate_limit")
  allowedOrigins String[] @default([]) @map("allowed_origins")
  
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz
  lastUsedIp    String?   @map("last_used_ip") @db.Inet
  isRevoked     Boolean   @default(false) @map("is_revoked")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy     String?   @map("revoked_by") @db.Uuid
  
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([orgId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@map("api_keys")
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  externalId  String   @unique @default(dbgenerated("'prj_' || encode(gen_random_bytes(16), 'hex')")) @map("external_id") @db.VarChar(32)
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(50)
  description String?
  settings    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  
  @@unique([orgId, slug])
  @@index([orgId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("viewer") @db.VarChar(20)
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  action         AuditAction
  
  userId         String?     @map("user_id") @db.Uuid
  orgId          String?     @map("org_id") @db.Uuid
  
  ipAddress      String?     @map("ip_address") @db.Inet
  userAgent      String?     @map("user_agent") @db.Text
  countryCode    String?     @map("country_code") @db.VarChar(2)
  sessionId      String?     @map("session_id") @db.Uuid
  requestId      String?     @map("request_id") @db.VarChar(64)
  
  targetUserId   String?     @map("target_user_id") @db.Uuid
  targetOrgId    String?     @map("target_org_id") @db.Uuid
  targetResource String?     @map("target_resource") @db.VarChar(100)
  targetId       String?     @map("target_id") @db.VarChar(100)
  
  metadata       Json        @default("{}")
  success        Boolean     @default(true)
  errorMessage   String?     @map("error_message")
  
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  
  user           User?       @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================================
// INVITATIONS
// ============================================================================

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.Citext
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  
  orgId       String?   @map("org_id") @db.Uuid
  teamId      String?   @map("team_id") @db.Uuid
  projectId   String?   @map("project_id") @db.Uuid
  
  role        OrgMemberRole @default(member)
  
  invitedBy   String    @map("invited_by") @db.Uuid
  message     String?
  
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  acceptedBy  String?   @map("accepted_by") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  
  inviter     User      @relation("InvitationSender", fields: [invitedBy], references: [id])
  
  @@index([email])
  @@index([tokenHash])
  @@index([orgId])
  @@map("invitations")
}

// ============================================================================
// NOTIFICATION PREFERENCES
// ============================================================================

model NotificationPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  
  emailLoginAlerts      Boolean  @default(true) @map("email_login_alerts")
  emailSecurityAlerts   Boolean  @default(true) @map("email_security_alerts")
  emailProductUpdates   Boolean  @default(false) @map("email_product_updates")
  emailMarketing        Boolean  @default(false) @map("email_marketing")
  
  pushEnabled           Boolean  @default(false) @map("push_enabled")
  pushSecurityAlerts    Boolean  @default(true) @map("push_security_alerts")
  
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notification_preferences")
}
