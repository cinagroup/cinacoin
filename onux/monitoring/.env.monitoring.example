# Monitoring Stack Environment Variables
# Copy to .env.monitoring and fill in the values

# ===================
# Grafana
# ===================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
GRAFANA_ROOT_URL=https://grafana.cinacoin.com

# ===================
# Slack Integration
# ===================
# Incoming Webhook URL for Slack alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===================
# PagerDuty Integration
# ===================
# Routing key for critical infrastructure alerts
PAGERDUTY_ROUTING_KEY=your_pagerduty_routing_key_here
# Routing key for security alerts (separate escalation)
PAGERDUTY_SECURITY_KEY=your_pagerduty_security_key_here

# ===================
# Sentry Integration
# ===================
# Sentry DSN for error tracking
SENTRY_DSN=https://your_sentry_dsn_here
# Sentry Auth Token for source maps
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ===================
# Cloudflare Logpush
# ===================
# Cloudflare zone ID for log collection
CF_ZONE_ID=your_cloudflare_zone_id
# Logpush destination (R2 or S3 bucket)
CF_LOGPUSH_DESTINATION=s3://cinacoin-logs/cloudflare/
# Cloudflare API Token
CF_API_TOKEN=your_cloudflare_api_token

# ===================
# Uptime Monitoring
# ===================
# UptimeRobot or BetterStack API key
UPTIME_API_KEY=your_uptime_monitoring_api_key

# ===================
# External URLs
# ===================
GRAFANA_URL=https://grafana.cinacoin.com
PROMETHEUS_URL=https://prometheus.cinacoin.com
ALERTMANAGER_URL=https://alertmanager.cinacoin.com
