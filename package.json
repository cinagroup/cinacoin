{
  "name": "cinacoin-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Cinacoin — Self-hosted wallet connection toolkit (monorepo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinagroup/cinacoin.git"
  },
  "bugs": {
    "url": "https://github.com/cinagroup/cinacoin/issues"
  },
  "homepage": "https://github.com/cinagroup/cinacoin#readme",
  "license": "MIT",
  "scripts": {
    "dev": "echo 'Use app-specific dev scripts (e.g. pnpm --filter @cinacoin/website dev)'",
    "build": "pnpm -r --stream build",
    "build:all": "pnpm -r --stream build",
    "test": "pnpm -r --stream test",
    "test:all": "pnpm -r --stream test",
    "test:coverage": "pnpm -r --stream test:coverage",
    "lint": "pnpm -r --stream lint",
    "lint:all": "pnpm -r --stream lint",
    "typecheck": "pnpm -r --stream typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "tsx scripts/release.ts",
    "release:dry-run": "tsx scripts/release.ts --dry-run",
    "sync-versions": "tsx scripts/sync-versions.ts",
    "generate-changelog": "tsx scripts/generate-changelog.ts",
    "package-graph": "tsx scripts/package-graph.ts",
    "prepublishOnly": "pnpm run build:all"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@changesets/changelog-github": "^0.5.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
