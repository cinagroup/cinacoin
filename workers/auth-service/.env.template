# =============================================================================
# CINAcoin OAuth Environment Variables Template
# =============================================================================
# This file documents all required environment variables for the Auth Service.
# DO NOT put actual secrets in this file.
# Use `wrangler secret put <NAME>` or Cloudflare Dashboard to set secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# JWT Configuration (set in wrangler.toml [vars] — non-secret)
# ---------------------------------------------------------------------------
JWT_ISSUER=https://auth.cinacoin.com
JWT_AUDIENCE=cinacoin
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
CORS_ORIGIN=https://cinacoin.com
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# JWT Secrets (SET VIA wrangler secret put — DO NOT store in files)
# ---------------------------------------------------------------------------
# JWT_SECRET=<random-64-char-string>
# JWT_REFRESH_SECRET=<random-64-char-string>

# Generate with:
#   openssl rand -base64 48

# ---------------------------------------------------------------------------
# Google OAuth 2.0
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://auth.cinacoin.com/auth/oauth/google/callback
# Scopes: openid email profile
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ---------------------------------------------------------------------------
# GitHub OAuth App
# Console: https://github.com/settings/developers
# Callback URL: https://auth.cinacoin.com/auth/oauth/github/callback
# Scope: user:email
# ---------------------------------------------------------------------------
# GITHUB_CLIENT_ID=<your-github-client-id>
# GITHUB_CLIENT_SECRET=<your-github-client-secret>

# ---------------------------------------------------------------------------
# Discord OAuth2
# Console: https://discord.com/developers/applications
# Redirect URI: https://auth.cinacoin.com/auth/oauth/discord/callback
# Scope: identify email
# ---------------------------------------------------------------------------
# DISCORD_CLIENT_ID=<your-discord-client-id>
# DISCORD_CLIENT_SECRET=<your-discord-client-secret>

# ---------------------------------------------------------------------------
# D1 Database (already configured in wrangler.toml)
