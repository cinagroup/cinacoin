{
  "name": "cinacoin-auth-workers",
  "version": "1.0.0",
  "private": true,
  "description": "Cinacoin Auth Service - Cloudflare Workers (Hono)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 execute cinacoin-auth --local --file=./migrations/001_init.sql",
    "db:migrate:prod": "wrangler d1 execute cinacoin-auth --remote --file=./migrations/001_init.sql"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "hono": "^4.4.0",
    "jose": "^5.6.0",
    "otpauth": "^9.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.60.0"
  }
}
