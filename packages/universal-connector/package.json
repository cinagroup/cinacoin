{
  "name": "@cinacoin/universal-connector",
  "version": "0.1.0",
  "description": "Universal multi-chain connector — unified interface for connecting to any blockchain",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx"
  },
  "license": "MIT",
  "dependencies": {
    "@cinacoin/core-sdk": "workspace:*",
    "@cinacoin/chain-registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
