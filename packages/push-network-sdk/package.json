{
  "name": "@cinacoin/push-network-sdk",
  "version": "0.1.0",
  "description": "Client SDK for Cinacoin Push Network — register devices and manage notification preferences on web, iOS, Android",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@cinacoin/logger": "workspace:*"
  }
}
