{
  "theme": {
    "name": "minimal",
    "mode": "dark",
    "colors": {
      "--cc-primary": "#ffffff",
      "--cc-on-primary": "#000000",
      "--cc-ink": "#ededed",
      "--cc-body": "#a3a3a3",
      "--cc-muted": "#737373",
      "--cc-hairline": "rgba(255, 255, 255, 0.08)",
      "--cc-hairline-strong": "rgba(255, 255, 255, 0.15)",
      "--cc-canvas": "#000000",
      "--cc-canvas-soft": "#0a0a0a",
      "--cc-canvas-soft-2": "#111111",
      "--cc-link": "#d4d4d4",
      "--cc-link-deep": "#ffffff",
      "--cc-link-bg-soft": "rgba(255, 255, 255, 0.1)",
      "--cc-success": "#4ade80",
      "--cc-success-bg": "rgba(74, 222, 128, 0.1)",
      "--cc-warning": "#facc15",
      "--cc-warning-bg": "rgba(250, 204, 21, 0.1)",
      "--cc-warning-soft": "rgba(250, 204, 21, 0.1)",
      "--cc-warning-deep": "#facc15",
      "--cc-error": "#f87171",
      "--cc-error-bg": "rgba(248, 113, 113, 0.1)",
      "--cc-error-soft": "rgba(248, 113, 113, 0.1)",
      "--cc-error-deep": "#f87171",
      "--cc-info": "#94a3b8",
      "--cc-info-bg": "rgba(148, 163, 184, 0.1)",
      "--cc-border": "rgba(255, 255, 255, 0.08)",
      "--cc-border-hover": "rgba(255, 255, 255, 0.15)",
      "--cc-border-focus": "#94a3b8"
    },
    "radii": {
      "--cc-rounded-xs": "4px",
      "--cc-rounded-sm": "6px",
      "--cc-rounded-md": "8px",
      "--cc-rounded-lg": "12px",
      "--cc-rounded-xl": "16px",
      "--cc-rounded-pill-sm": "64px",
      "--cc-rounded-pill": "100px",
      "--cc-rounded-full": "9999px"
    },
    "shadows": {
      "--cc-level0": "none",
      "--cc-level1": "0 0 0 1px rgba(255, 255, 255, 0.06) inset",
      "--cc-level2": "0px 1px 2px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.06) inset",
      "--cc-level3": "0px 2px 4px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.06) inset",
      "--cc-level4": "0px 4px 8px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.06) inset",
      "--cc-level5": "0px 8px 16px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.06) inset"
    },
    "typography": {
      "--cc-font-family": "'Geist', 'Inter', system-ui, -apple-system, sans-serif",
      "--cc-font-family-mono": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, monospace",
      "--cc-font-size-xs": "12px",
      "--cc-font-size-sm": "14px",
      "--cc-font-size-md": "16px",
      "--cc-font-size-lg": "18px",
      "--cc-font-size-xl": "24px",
      "--cc-font-size-2xl": "32px",
      "--cc-font-size-3xl": "48px",
      "--cc-font-weight-normal": "400",
      "--cc-font-weight-medium": "500",
      "--cc-font-weight-semibold": "500",
      "--cc-font-weight-bold": "600"
    },
    "spacing": {
      "--cc-xxs": "4px",
      "--cc-xs": "8px",
      "--cc-sm": "12px",
      "--cc-md": "16px",
      "--cc-lg": "24px",
      "--cc-xl": "32px",
      "--cc-2xl": "40px",
      "--cc-3xl": "48px",
      "--cc-4xl": "64px",
      "--cc-5xl": "96px",
      "--cc-6xl": "128px",
      "--cc-section": "192px"
    },
    "animations": {
      "--cc-duration-fast": "100ms",
      "--cc-duration-normal": "200ms",
      "--cc-duration-slow": "300ms",
      "--cc-easing-default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--cc-easing-spring": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "zIndex": {
      "--cc-z-dropdown": "1000",
      "--cc-z-modal-backdrop": "2000",
      "--cc-z-modal": "2100",
      "--cc-z-toast": "3000",
      "--cc-z-tooltip": "4000"
    }
  }
}
