{
  "name": "@cinacoin/verify-sdk",
  "version": "0.1.0",
  "description": "Contract safety scoring and phishing detection SDK — inspired by Reown Verify",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "verify",
    "contract-safety",
    "phishing-detection",
    "blockchain",
    "cinacoin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^3.3.0",
    "eventemitter3": "^5.0.1",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.8.3",
    "vitest": "^1.2.0",
    "tsc-alias": "^1.8.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  }
}
