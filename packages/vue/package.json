{
  "name": "@cinacoin/vue",
  "version": "0.2.0",
  "description": "Vue adapter for Cinacoin white-label UI toolkit",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "@cinacoin/core-sdk": "^0.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
