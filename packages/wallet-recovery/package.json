{
  "name": "@cinacoin/wallet-recovery",
  "version": "0.2.0",
  "description": "Cinacoin Wallet Recovery — Shamir's Secret Sharing with multi-provider wallet recovery",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/react": "^19.2.17",
    "eslint": "^8.56.0",
    "typescript": "^5.8.3",
    "vitest": "^1.2.0",
    "tsup": "^8.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
