{
  "name": "@cinacoin/chain-registry",
  "version": "0.1.0",
  "description": "EVM chain registry with 100+ chains — CAIP-2 compatible, auto-generated from chainlist.org",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./chains": {
      "types": "./dist/chains.d.ts",
      "import": "./dist/chains.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "fetch-chains": "tsx scripts/fetch-chains.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
