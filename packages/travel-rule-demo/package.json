{
  "name": "@cinacoin/travel-rule-demo",
  "version": "0.2.0",
  "description": "Travel Rule compliance demo for VASP integration",
  "scripts": {
    "demo": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "dependencies": {
    "ethers": "^6.13",
    "axios": "^1.7",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.19.0",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false
}
