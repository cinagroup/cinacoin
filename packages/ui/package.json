{
  "name": "@cinacoin/ui",
  "version": "0.1.0",
  "description": "Shared Cinacoin UI components (Brand, SiteHeader, SiteFooter) — framework-agnostic React.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "19.2.6",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  }
}
