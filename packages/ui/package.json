{
  "name": "@cinacoin/ui",
  "version": "0.1.0",
  "description": "Shared Cinacoin UI components (Brand, SiteHeader, SiteFooter) — framework-agnostic React.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./modal": {
      "import": {
        "types": "./dist/Modal.d.ts",
        "default": "./dist/Modal.js"
      },
      "require": {
        "types": "./dist/Modal.d.cts",
        "default": "./dist/Modal.cjs"
      }
    },
    "./brand": {
      "import": {
        "types": "./dist/Brand.d.ts",
        "default": "./dist/Brand.js"
      },
      "require": {
        "types": "./dist/Brand.d.cts",
        "default": "./dist/Brand.cjs"
      }
    },
    "./site-header": {
      "import": {
        "types": "./dist/SiteHeader.d.ts",
        "default": "./dist/SiteHeader.js"
      },
      "require": {
        "types": "./dist/SiteHeader.d.cts",
        "default": "./dist/SiteHeader.cjs"
      }
    },
    "./site-footer": {
      "import": {
        "types": "./dist/SiteFooter.d.ts",
        "default": "./dist/SiteFooter.js"
      },
      "require": {
        "types": "./dist/SiteFooter.d.cts",
        "default": "./dist/SiteFooter.cjs"
      }
    },
    "./empty-state": {
      "import": {
        "types": "./dist/EmptyState.d.ts",
        "default": "./dist/EmptyState.js"
      },
      "require": {
        "types": "./dist/EmptyState.d.cts",
        "default": "./dist/EmptyState.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@testing-library/jest-axe": "^9.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "react": "19.2.6",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  }
}
