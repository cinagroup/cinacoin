{
  "name": "@cinacoin/relay-server",
  "version": "0.2.0",
  "description": "WalletConnect relay server for Cinacoin — HTTP/WebSocket relay interface",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@cinacoin/core-sdk": "workspace:*",
    "@cinacoin/walletconnect-v2": "workspace:*",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/ws": "^8.5.0",
    "typescript": "^5.8.3",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false
}
