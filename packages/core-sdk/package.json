{
  "name": "@cinacoin/core-sdk",
  "version": "0.2.0",
  "description": "Cinacoin Core SDK — Self-hosted wallet connection toolkit",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./chains": {
      "import": "./dist/chains.js",
      "types": "./dist/chains.d.ts"
    },
    "./utils/signature": {
      "import": "./dist/utils/signature.js",
      "types": "./dist/utils/signature.d.ts"
    },
    "./utils/chain": {
      "import": "./dist/utils/chain.js",
      "types": "./dist/utils/chain.d.ts"
    },
    "./utils/circuitBreaker.js": {
      "import": "./dist/utils/circuitBreaker.js",
      "types": "./dist/utils/circuitBreaker.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:direct": "npx tsx tests/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@cinacoin/caip": "workspace:*",
    "@cinacoin/chain-registry": "workspace:^",
    "@cinacoin/siwe": "workspace:*",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "viem": "^2.9.0",
    "zustand": "^4.5.0",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "1",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^1.2.0",
    "tsup": "^8.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
