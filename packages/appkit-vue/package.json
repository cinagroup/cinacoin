{
  "name": "@cinacoin/appkit-vue",
  "version": "0.1.0",
  "description": "Cinacoin AppKit Vue 3 adapter — composable and components for Vue apps",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@cinacoin/appkit": "workspace:*",
    "@cinacoin/core-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^8.56.0",
    "typescript": "^5.8.3",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
