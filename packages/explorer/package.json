{
  "name": "@cinacoin/explorer",
  "version": "0.2.0",
  "description": "Explorer API — wallet/dApp discovery, logo fetching, registry",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@cinacoin/core-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false
}
