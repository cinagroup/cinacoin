{
  "name": "@cinacoin/core-ui",
  "version": "0.2.0",
  "description": "Web Components core for Cinacoin — built with Lit",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx"
  },
  "dependencies": {
    "lit": "^3.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "jsdom": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
