{
  "name": "@cinacoin/codemod",
  "version": "0.2.0",
  "description": "Codemods for migrating from Web3Modal/AppKit and WalletConnect v1 to Cinacoin",
  "bin": {
    "cinacoin-codemod": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "jest --config jest.config.js",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx"
  },
  "keywords": [
    "cinacoin",
    "codemod",
    "migration",
    "web3modal",
    "appkit",
    "walletconnect"
  ],
  "license": "MIT",
  "dependencies": {
    "glob": "^10.3.0",
    "yargs": "^17.7.0",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.32",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.8.3",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false
}
