{
  "name": "@cinacoin/gas-estimator",
  "version": "0.2.0",
  "description": "Cinacoin Gas Estimator — EIP-1559 and Solana compute budget gas estimation",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "viem": "^2.9.0",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0",
    "tsup": "^8.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
