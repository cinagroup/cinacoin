{
  "name": "@cinacoin/social-login",
  "version": "0.2.0",
  "description": "Cinacoin Social Login — OAuth2 and email-based wallet authentication with deterministic HD wallet derivation",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "jose": "^5.2.0",
    "@noble/hashes": "^1.3.3",
    "@noble/curves": "^1.3.0",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/react": "19.2.17",
    "react": "^19.2.7",
    "typescript": "^5.8.3",
    "eslint": "^8.56.0",
    "vitest": "^1.2.0",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
