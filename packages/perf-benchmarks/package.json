{
  "name": "@cinacoin/perf-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Performance benchmark suite for Cinacoin SDK — P50/P95/P99 metrics with regression guard",
  "type": "module",
  "scripts": {
    "bench": "tsx src/run.ts",
    "bench:init": "tsx src/run.ts --filter=sdk-init",
    "bench:wc": "tsx src/run.ts --filter=wallet-connect",
    "bench:chain": "tsx src/run.ts --filter=chain-switch",
    "bench:tx": "tsx src/run.ts --filter=transaction-build",
    "bench:ci": "tsx src/run.ts --ci --baseline-file baseline.json --regression-threshold 20",
    "baseline:save": "tsx src/run.ts --save-baseline baseline.json",
    "report": "tsx src/report.ts",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cinacoin/core-sdk": "workspace:*",
    "@cinacoin/react": "workspace:*",
    "@cinacoin/vue": "workspace:*",
    "@cinacoin/walletconnect-v2": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "viem": "^2.9.0"
  }
}
