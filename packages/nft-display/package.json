{
  "name": "@cinacoin/nft-display",
  "version": "0.1.0",
  "description": "Cinacoin NFT Display — Multi-chain NFT fetching, metadata, and React components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fetcher": {
      "import": "./dist/fetcher.mjs",
      "require": "./dist/fetcher.js",
      "types": "./dist/fetcher.d.ts"
    },
    "./components": {
      "import": "./dist/components.mjs",
      "require": "./dist/components.js",
      "types": "./dist/components.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.js",
      "types": "./dist/hooks.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/fetcher.ts src/components.tsx src/hooks.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts src/fetcher.ts src/components.tsx src/hooks.ts --format cjs,esm --dts --external react --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "18.3.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
