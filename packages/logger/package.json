{
  "name": "@cinacoin/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.5.4"
  }
}
