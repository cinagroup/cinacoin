{
  "name": "@cinacoin/adapters",
  "version": "0.2.0",
  "description": "Cinacoin wallet adapters — MetaMask, WalletConnect, Coinbase, Phantom, Bitcoin",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./metamask": {
      "import": "./dist/metamask/index.js",
      "types": "./dist/metamask/index.d.ts"
    },
    "./walletconnect": {
      "import": "./dist/walletconnect/index.js",
      "types": "./dist/walletconnect/index.d.ts"
    },
    "./coinbase": {
      "import": "./dist/coinbase/index.js",
      "types": "./dist/coinbase/index.d.ts"
    },
    "./phantom": {
      "import": "./dist/phantom/index.js",
      "types": "./dist/phantom/index.d.ts"
    },
    "./btc": {
      "import": "./dist/btc/index.js",
      "types": "./dist/btc/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cinacoin/core-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
