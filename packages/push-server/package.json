{
  "name": "@cinacoin/push-server",
  "version": "0.3.0",
  "description": "Push notification server for Cinacoin — APNs and FCM delivery with device registry, rate limiting, and notification types",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "dependencies": {
    "@cinacoin/core-sdk": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/node": "^20.11.0",
    "typescript": "^6.0.3",
    "wrangler": "^3.87.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false
}
