{
  "name": "@cinacoin/push-server",
  "version": "0.3.0",
  "description": "Push notification server for Cinacoin — APNs and FCM delivery with device registry, rate limiting, and notification types",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@cinacoin/core-sdk": "workspace:*",
    "@cinacoin/logger": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.8.3",
    "wrangler": "^3.87.0",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false
}
