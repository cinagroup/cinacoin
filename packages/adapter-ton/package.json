{
  "name": "@cinacoin/adapter-ton",
  "version": "1.0.0",
  "description": "TON chain adapter for Cinacoin — @ton/ton based, Jetton support, address validation",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@cinacoin/core-sdk": "workspace:*"
  },
  "dependencies": {
    "@cinacoin/core-sdk": "workspace:*",
    "@ton/ton": "^15.0.0",
    "@ton/core": "^0.60.0",
    "@ton/crypto": "^3.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false
}
