{
  "name": "@cinacoin/appkit-next",
  "version": "0.1.0",
  "description": "Cinacoin AppKit Next.js adapter — SSR-safe wrappers for Next.js App Router",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@cinacoin/appkit": "workspace:*",
    "@cinacoin/appkit-react": "workspace:*",
    "@cinacoin/core-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "eslint": "^8.56.0",
    "typescript": "^5.8.3",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
