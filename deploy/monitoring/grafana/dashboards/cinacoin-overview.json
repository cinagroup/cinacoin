{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "id": null,
  "uid": "cinacoin-overview",
  "title": "Cinacoin — Global Overview (RED)",
  "description": "Top-level SLO, QPS, latency, error rate, and saturation overview for all Cinacoin services.",
  "tags": ["cinacoin", "overview", "red", "slo"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "service",
        "type": "custom",
        "query": "rpc-proxy,relay-server,keys-server,notify-server,push-server,bundler",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "🟢 Overall Availability (30d)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "avg(avg_over_time(cinacoin_service_up{service=~\"$service\"}[30d])) * 100",
          "legendFormat": "Availability %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99 },
              { "color": "yellow", "value": 99.9 },
              { "color": "green", "value": 99.95 }
            ]
          },
          "decimals": 3
        }
      }
    },
    {
      "id": 2,
      "title": "📊 Total QPS",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(cinacoin_http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "QPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "⏱️ P95 Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cinacoin_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le)) * 1000",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "❌ Error Rate (5xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(cinacoin_http_errors_total{service=~\"$service\",status_code=~\"5..\"}[5m])) / sum(rate(cinacoin_http_requests_total{service=~\"$service\"}[5m])) * 100",
          "legendFormat": "Error Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "decimals": 3
        }
      }
    },
    {
      "id": 5,
      "title": "Service Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "cinacoin_service_up{service=~\"$service\"}",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "service": "Service", "Value": "Status" } } }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 10,
      "title": "QPS by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(cinacoin_http_requests_total{service=~\"$service\"}[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } }
      }
    },
    {
      "id": 11,
      "title": "Latency Distribution (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cinacoin_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le)) * 1000",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cinacoin_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le)) * 1000",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cinacoin_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])) by (le)) * 1000",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 2 } }
      }
    },
    {
      "id": 12,
      "title": "Error Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(cinacoin_http_errors_total{service=~\"$service\"}[5m])) by (service) / sum(rate(cinacoin_http_requests_total{service=~\"$service\"}[5m])) by (service) * 100",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } }
      }
    },
    {
      "id": 13,
      "title": "Saturation — CPU Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 18 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "avg(cinacoin_cpu_usage_percent{container=~\"$service\"})",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Saturation — Memory Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 18 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "avg(cinacoin_memory_usage_percent{container=~\"$service\"})",
          "legendFormat": "Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "title": "Error Budget Remaining (30d)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "relay_error_budget_remaining * 100", "legendFormat": "Relay" },
        { "expr": "rpc_error_budget_remaining * 100", "legendFormat": "RPC Proxy" },
        { "expr": "bundler_error_budget_remaining * 100", "legendFormat": "Bundler" },
        { "expr": "keys_error_budget_remaining * 100", "legendFormat": "Keys Server" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      }
    },
    {
      "id": 21,
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "cinacoin_monitoring_alerts{severity=\"critical\"}", "legendFormat": "Critical" },
        { "expr": "cinacoin_monitoring_alerts{severity=\"warning\"}", "legendFormat": "Warning" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
