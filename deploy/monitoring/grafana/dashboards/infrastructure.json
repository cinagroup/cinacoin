{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "infrastructure",
  "title": "Cinacoin — Infrastructure Monitoring",
  "description": "CPU, memory, disk, network, pod health, and Kubernetes cluster status.",
  "tags": ["cinacoin", "infrastructure", "kubernetes"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(cinacoin_cpu_usage_percent, instance)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "container",
        "type": "query",
        "query": "label_values(cinacoin_cpu_usage_percent, container)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "🖥️ Cluster CPU Usage",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "avg(cinacoin_cpu_usage_percent{instance=~\"$instance\",container=~\"$container\"})", "legendFormat": "CPU" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 2,
      "title": "🧠 Cluster Memory Usage",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "avg(cinacoin_memory_usage_percent{instance=~\"$instance\",container=~\"$container\"})", "legendFormat": "Memory" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 3,
      "title": "💾 Disk Usage",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "avg(cinacoin_disk_usage_percent{instance=~\"$instance\"})", "legendFormat": "Disk" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 4,
      "title": "🟢 Healthy Pods",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "sum(cinacoin_pod_ready{namespace=\"cinacoin\"})", "legendFormat": "Ready" },
        { "expr": "sum(cinacoin_pod_count{namespace=\"cinacoin\",status=\"running\"})", "legendFormat": "Running" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0 }] } } }
    },
    {
      "id": 10,
      "title": "CPU Usage by Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "cinacoin_cpu_usage_percent{instance=~\"$instance\",container=~\"$container\"}", "legendFormat": "{{container}} @ {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "id": 11,
      "title": "Memory Usage by Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "cinacoin_memory_usage_bytes{instance=~\"$instance\",container=~\"$container\"}", "legendFormat": "{{container}} @ {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "id": 12,
      "title": "Disk I/O",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "rate(cinacoin_disk_read_bytes_total{instance=~\"$instance\"}[5m])", "legendFormat": "Read {{device}}" },
        { "expr": "rate(cinacoin_disk_write_bytes_total{instance=~\"$instance\"}[5m])", "legendFormat": "Write {{device}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "id": 13,
      "title": "Network Bandwidth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "cinacoin_network_bandwidth_bps{instance=~\"$instance\",direction=\"rx\"}", "legendFormat": "RX {{interface}}" },
        { "expr": "cinacoin_network_bandwidth_bps{instance=~\"$instance\",direction=\"tx\"}", "legendFormat": "TX {{interface}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "id": 20,
      "title": "Pod Restarts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "increase(cinacoin_pod_restarts_total{namespace=\"cinacoin\"}[1h])", "legendFormat": "{{pod}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 50 } } }
    },
    {
      "id": 21,
      "title": "Active Network Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "sum(cinacoin_network_connections_active{instance=~\"$instance\"}) by (protocol, state)", "legendFormat": "{{protocol}} {{state}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "id": 30,
      "title": "Node Resource Table",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "cinacoin_cpu_usage_percent{instance=~\"$instance\",container=~\"$container\"}", "format": "table", "instant": true },
        { "expr": "cinacoin_memory_usage_percent{instance=~\"$instance\",container=~\"$container\"}", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge" }
      ],
      "options": { "showHeader": true }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
