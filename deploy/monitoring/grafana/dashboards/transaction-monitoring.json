{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "transaction-monitoring",
  "title": "Cinacoin — Transaction Monitoring",
  "description": "Real-time transaction metrics, gas prices, mempool status, and blockchain health.",
  "tags": ["cinacoin", "transactions", "blockchain"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "chain",
        "type": "custom",
        "query": "ethereum,polygon,arbitrum,optimism",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "💰 Total Transactions (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(increase(cinacoin_transactions_total{chain=~\"$chain\"}[1h]))",
          "legendFormat": "Transactions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "⏳ Pending Transactions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(cinacoin_transactions_pending{chain=~\"$chain\"})",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "orange", "value": 5000 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "⛽ Gas Price (Gwei)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "avg(cinacoin_gas_price_gwei{chain=~\"$chain\",priority=\"standard\"})",
          "legendFormat": "Gas Price"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "🔗 Block Height",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "max(cinacoin_chain_block_height{chain=~\"$chain\"}) by (chain)",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Transaction Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(cinacoin_transactions_total{chain=~\"$chain\"}[5m])) by (chain) * 60",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 11,
      "title": "Transaction Confirmation Time (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cinacoin_transaction_confirmation_seconds_bucket{chain=~\"$chain\"}[5m])) by (le, chain))",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 12,
      "title": "Gas Price Trends",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "cinacoin_gas_price_gwei{chain=~\"$chain\",priority=\"low\"}", "legendFormat": "{{chain}} Low" },
        { "expr": "cinacoin_gas_price_gwei{chain=~\"$chain\",priority=\"standard\"}", "legendFormat": "{{chain}} Standard" },
        { "expr": "cinacoin_gas_price_gwei{chain=~\"$chain\",priority=\"high\"}", "legendFormat": "{{chain}} High" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 13,
      "title": "Mempool Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "cinacoin_mempool_size{chain=~\"$chain\"}",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 20,
      "title": "Chain Sync Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "cinacoin_chain_sync_status{chain=~\"$chain\"}",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "chain": "Chain", "region": "Region", "Value": "Synced" } } }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 21,
      "title": "Node Peer Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "cinacoin_node_peer_count{chain=~\"$chain\"}",
          "legendFormat": "{{chain}} - {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 22,
      "title": "Block Height Growth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "rate(cinacoin_chain_block_height{chain=~\"$chain\"}[5m]) * 60",
          "legendFormat": "{{chain}} - {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 30,
      "title": "Transaction Value (ETH)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(cinacoin_transactions_value_eth{chain=~\"$chain\"}[5m])) by (chain) * 3600",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ETH",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 31,
      "title": "Gas Used per Block",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "cinacoin_gas_used_per_block{chain=~\"$chain\"}",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
