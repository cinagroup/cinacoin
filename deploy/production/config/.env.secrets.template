# =============================================================================
# Cinacoin Production Secrets Template
# Copy this to .env.secrets and fill in actual values
#
# ⚠️  SECURITY WARNING: Never commit real values to this file.
#       All placeholders below MUST be replaced with real values only
#       in the local .env.secrets file (which is gitignored).
# =============================================================================

# Database
DB_PASSWORD=<YOUR_DB_PASSWORD_HERE>

# Redis
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD_HERE>

# OAuth Providers (register these in provider dashboards)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID_HERE>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET_HERE>

GITHUB_CLIENT_ID=<YOUR_GITHUB_CLIENT_ID_HERE>
GITHUB_CLIENT_SECRET=<YOUR_GITHUB_CLIENT_SECRET_HERE>

DISCORD_CLIENT_ID=<YOUR_DISCORD_CLIENT_ID_HERE>
DISCORD_CLIENT_SECRET=<YOUR_DISCORD_CLIENT_SECRET_HERE>

# Application Secrets
OAUTH_STATE_SECRET=<YOUR_OAUTH_STATE_SECRET_HERE>
SESSION_SECRET=<YOUR_SESSION_SECRET_HERE>
ENCRYPTION_KEY=<YOUR_ENCRYPTION_KEY_HERE>
WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET_HERE>

# Email (SMTP)
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD_HERE>

# Monitoring
SENTRY_DSN=<YOUR_SENTRY_DSN_HERE>
