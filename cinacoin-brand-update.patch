+          <p className={`font-mono text-sm mt-0.5 ${service.responseTime !== null && service.responseTime < 1000 ? "text-emerald-400" : service.responseTime !== null && service.responseTime < 3000 ? "text-yellow-400" : "text-red-400"}`}>
