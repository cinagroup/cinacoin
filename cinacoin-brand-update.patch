+# ─── Package counts ───
+TOTAL_PACKAGES=$(find packages -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
+BUILT_PACKAGES=$(find packages -maxdepth 2 -name "dist" -type d -not -path "*/node_modules/*" 2>/dev/null | wc -l)
