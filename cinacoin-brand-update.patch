+ */
+export interface CosmosMsg {
+  /** Message type URI (e.g. '/cosmos.bank.v1beta1.MsgSend'). */
+  typeUrl: string;
+  /** Message value as JSON-compatible object. */
+  value: Record<string, unknown>;
