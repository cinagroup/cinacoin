+  useCinaConnect,
+  useAccount,
+  useChainId,
+  useDisconnect,
+  useConnect,
+  ChainSwitcher,
+  ConnectButton,
+} from '@cinaconnect/react'
+
+function MultiChainApp() {
+  const account = useAccount()
+  const chainId = useChainId()
+  const { disconnect, status } = useCinaConnect()
+  const { connect, isSwitchingChain } = useConnect()
