+pnpm audit --audit-level=high
+
+# Monthly: secret scan
+gitleaks detect --source . --report-path gitleaks-report.json
+
+# Monthly: outdated dependencies
+pnpm outdated
+
+# Quarterly: full security review
+# - Penetration test
+# - CSP report review
+# - Error log analysis
+# - Incident response drill
