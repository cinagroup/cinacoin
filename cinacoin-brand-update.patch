+ * CosmWasm execute message descriptor.
+ */
+export interface CosmWasmExecute {
+  /** Contract bech32 address. */
+  contractAddress: string;
+  /** Execute message (JSON-serializable). */
+  msg: Record<string, unknown>;
+  /** Coins to attach (optional). */
+  funds?: CosmosCoin[];
