+    expect(NextResponse.next).toHaveBeenCalled();
+  });
+});
+
+// ---------------------------------------------------------------------------
+// EIP-5792 Server Utilities Tests
+// ---------------------------------------------------------------------------
+
+describe('EIP-5792 — getWalletCapabilitiesOnServer', () => {
+  beforeEach(() => {
+    vi.stubGlobal('fetch', vi.fn());
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
