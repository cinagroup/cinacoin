+  '0x2105': 'Base',
+  '0x38': 'BNB Chain',
+  '0xa86a': 'Avalanche',
+  '0xaa36a7': 'Sepolia',
+  '0x5': 'Goerli',
+  '0x13881': 'Mumbai',
+  '0x144': 'zkSync Mainnet',
+};
