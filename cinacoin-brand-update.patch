+
+  it('should verify transaction when callId is a tx hash', async () => {
+    const { verifyBatchCallOnServer } = await import('../src/server/eip5792.js');
+
+    const txHash = '0x' + 'a'.repeat(64);
+    vi.mocked(fetch).mockResolvedValue({
+      json: async () => ({
+        result: {
