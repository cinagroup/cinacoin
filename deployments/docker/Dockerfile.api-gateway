# API Gateway Dockerfile
# Based on Kong Gateway for production-grade API management

FROM kong:3.5-alpine AS base

# Install custom plugins if needed
USER root
RUN apk add --no-cache curl

# Copy custom Kong configuration
COPY kong.conf /etc/kong/kong.conf
COPY plugins/ /usr/local/share/lua/5.1/kong/plugins/

# Copy declarative config
COPY kong.yml /etc/kong/kong.yml

USER kong

EXPOSE 8000 8443 8001 8444

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD kong health

CMD ["kong", "docker-start"]
